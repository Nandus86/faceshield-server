# ── Banco de Dados (PostgreSQL com pgvector) ─────────────────
# No docker-compose use db como host; local use localhost.
DATABASE_URL=postgresql+asyncpg://faceshield:faceshield_secret@db:5432/faceshield

# ── Agente de IA (Opcional — insights e resumo executivo) ────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Reconhecimento Facial (InsightFace ArcFace 512-d) ────────
FACE_MODEL=buffalo_l
DET_SIZE=320                  # 320 = mais rápido | 640 = equilibrado | 1280 = mais preciso
SIMILARITY_THRESHOLD=0.65     # menor = mais restritivo
MIN_FACE_SIZE=40
MIN_DET_SCORE=0.40
COOLDOWN_MINUTES=60
MIN_SIGHTINGS=2               # avistamentos antes de cadastrar desconhecido
SIGHTING_TTL_MINUTES=10

# ── Retenção e limpeza ───────────────────────────────────────
IMAGE_RETENTION_HOURS=48
CLEANUP_INTERVAL_HOURS=1

# ── Câmeras e ingestão ───────────────────────────────────────
CAMERA_INDEX=0
USE_A9_CAMERA=false
RTSP_FRAME_INTERVAL=2.0       # segundos entre frames por câmera RTSP
ANALYSIS_INTERVAL=0.5         # segundos entre análises da câmera ao vivo
PRESENCE_TIMEOUT_SECONDS=30   # sem detecção nesse intervalo = pessoa saiu
